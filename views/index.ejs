<h1>Clubhouse</h1>

<% if (messages.length === 0) { %>
  <p>No messages yet.</p>
<% } %>

<% messages.forEach(message => { %>
  <article>
    <h2><%= message.title %></h2>

    <p><%= message.message %></p>

    <% if (currentUser && currentUser.is_member) { %>
      <small>
        Posted by
        <%= message.first_name %> <%= message.last_name %>
        on
        <%= message.created_at.toLocaleString() %>
      </small>
    <% } %>
  </article>
<% }) %>