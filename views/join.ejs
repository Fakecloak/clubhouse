<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Join the Club</title>
</head>

<body>

  <h1>Join the Club</h1>

  <form action="/join" method="POST">

    <label for="passcode">Secret Passcode</label>

    <input
      type="password"
      id="passcode"
      name="passcode"
      required
    >

    <button type="submit">Join</button>

  </form>

  <a href="/">Back</a>

</body>
</html>