<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Login Portal</title>
</head>
<body>

<h1>Login</h1>

<form action="/auth/login" method="POST">

    <input
        type="email"
        name="email"
        placeholder="Email"
        value="<%= formData?.email || '' %>"
    >

    <input
        type="password"
        name="password"
        placeholder="Password"
    >

    <button type="submit">
        Create Account
    </button>

</form>

<p>Create a new account</p>
<a href="/auth/sign-up">Create</a>

</body>
</html>