<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create Message</title>
</head>
<body>

  <h1>Create a Message</h1>

  <!-- Display the errors -->
  <% if (errors && errors.length > 0 ) { %>
    <ul>
      <% errors.forEach(error => { %>
        <li> <%= error.msg  %></li>
      <% }) %> 
    </ul>
  <% } %>

  <form action="/msg/new" method="POST">

    <input
    id="title"
      type="text"
      name="title"
      placeholder="Message title"
      required
    >

    <br><br>

    <textarea
      id="message"
      name="message"
      placeholder="Write your message..."
      required
    ></textarea>

    <br><br>

    <button type="submit">
      Post Message
    </button>

  </form>

</body>
</html>